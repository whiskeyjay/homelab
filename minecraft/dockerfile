FROM amazoncorretto:27

EXPOSE 25565/tcp
WORKDIR /minecraft

# Install udev, and wget
RUN yum install -y udev wget && yum clean all

# Download the Minecraft server jar
RUN wget -O server.jar https://piston-data.mojang.com/v1/objects/33680f5f2ac32864d6d7cf5e56a705fdb3e05f4c/server.jar

# Accept the EULA
RUN echo "eula=true" > eula.txt

ENTRYPOINT ["sh", "-c", "cd $MC_SVR_PATH && cp /minecraft/*.* $MC_SVR_PATH && java --enable-native-access=ALL-UNNAMED -Xmx$MC_MEM_MAX -Xms$MC_MEM_MIN -jar ./server.jar nogui"]
